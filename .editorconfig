root = true

[*]
charset = utf-8
max_line_length = 120
indent_style = space
insert_final_newline = false
indent_size = 4
trim_trailing_whitespace = true

[{*.json,.stylelintrc}]
indent_size = 2

[*.scss]
insert_final_newline = true
indent_size = 2

[*.js]
insert_final_newline = true
indent_size = 2

[*.md]
trim_trailing_whitespace = false
